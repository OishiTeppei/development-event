# .env.example
# このファイルをコピーして .env を作成してください。
#   cp .env.example .env
#
# MYSQL_DATABASE / DB_HOST はアプリケーションの前提になっている値のため変更しないでください。
# MYSQL_ROOT_PASSWORD / MYSQL_USER / MYSQL_PASSWORD は各自で自由な値に変更して構いません。

MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password

DB_HOST=db
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password
